{
  "expo": {
    "name": "Lunula",
    "slug": "lunula",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00897B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lunula.app",
      "buildNumber": "4",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Lunula uses Face ID to protect access to your health data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00897B"
      },
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lunula.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "lunula",
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-local-authentication",
      "expo-sharing",
      "expo-mail-composer",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec916ed4-e882-4ee2-92bf-20f0c3ce644d"
      }
    },
    "owner": "rdmillen"
  }
}
